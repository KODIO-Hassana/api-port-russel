<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Tableau de bord - Port de Russell</title>

    <style>
    body { font-family: sans-serif; margin: 40px; line-height: 1.6; background-color: #f8f9fa; }
    
    .add-catway-section {
        background: #f4f4f4;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 40px; 
        border: 1px solid #ddd;
    }

    form div { margin-bottom: 10px; }
    label { display: inline-block; width: 100px; font-weight: bold; }
    input, select { padding: 8px; border-radius: 4px; border: 1px solid #ccc; }

    button { 
        padding: 10px 20px; 
        background: hsl(272, 100%, 50%); 
        color: white; 
        border: none; 
        border-radius: 4px; 
        cursor: pointer; 
    }
    button:hover { background: #0056b3; }

    hr { border: 0; border-top: 2px solid #eee; margin: 40px 0; }

    li {
        margin-bottom: 15px;
        padding: 10px;
        background-color: #fff;
        border-radius: 5px;
        list-style: none;
        display: flex;
        align-items: center;
        border: 1px solid #ddd;
    }

    .btn-edit, .btn-reservations, .btn-delete {
        text-decoration: none;
        padding: 6px 12px;
        border-radius: 4px;
        font-size: 0.9em;
        margin-left: 10px;
        color: white;
        display: inline-block;
        border: none;
        cursor: pointer;
    }

    .btn-reservations { background-color: #28a745; } 
    .btn-edit { background-color: #007bff; }         
    .btn-delete { background-color: #dc3545; }
    </style>
</head>
<body>

    <header style="background: #0056b3; color: white; padding: 20px; border-radius: 8px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
        <div>
            <h2 style="margin: 0;">👤 Bienvenue, <%= user.username %></h2>
            <p style="margin: 5px 0 0 0; font-size: 1em;">✉️ <%= user.email %></p>
        </div>
        <div style="text-align: right; font-size: 1.2em; font-weight: bold;">
            <span id="date-jour"></span>
        </div>
    </header>

    <nav style="background: #fff; padding: 15px; border-radius: 8px; margin-bottom: 30px; display: flex; gap: 20px; border: 1px solid #ddd; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">
        <a href="/dashboard" style="text-decoration: none; font-weight: bold; color: #0056b3;">🏠 Accueil / Tableau de bord</a>
        <a href="/dashboard/users" style="text-decoration: none; font-weight: bold; color: #333;">👥 Gestion Utilisateurs</a>
        <a href="/docs" style="text-decoration: none; font-weight: bold; color: #17a2b8;">📖 Documentation API</a>
        <a href="/auth/logout" style="text-decoration: none; font-weight: bold; color: #dc3545; margin-left: auto;">🚪 Se déconnecter</a>
    </nav>

    <h1>Tableau de bord de la Capitainerie</h1>
    <hr>

    <h2>📋 Réservations du port en cours</h2>
    <div style="background: #fff; padding: 15px; border-radius: 8px; border: 1px solid #ddd; margin-bottom: 40px; max-height: 300px; overflow-y: auto;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background-color: #343a40; color: white; text-align: left;">
                    <th style="padding: 10px; border: 1px solid #ddd;">N° Catway</th>
                    <th style="padding: 10px; border: 1px solid #ddd;">Client</th>
                    <th style="padding: 10px; border: 1px solid #ddd;">Bateau</th>
                    <th style="padding: 10px; border: 1px solid #ddd;">Arrivée</th>
                    <th style="padding: 10px; border: 1px solid #ddd;">Départ</th>
                </tr>
            </thead>
            <tbody>
                <% if (reservations && reservations.length > 0) { %>
                    <% reservations.forEach(function(resv) { %>
                        <tr style="border-bottom: 1px solid #eee;">
                            <td style="padding: 8px;"><span style="background: #e9ecef; padding: 3px 8px; border-radius: 4px; font-weight: bold;">#<%= resv.catwayNumber %></span></td>
                            <td style="padding: 8px;"><%= resv.clientName %></td>
                            <td style="padding: 8px;"><%= resv.boatName %></td>
                            <td style="padding: 8px;"><%= resv.startDate ? new Date(resv.startDate).toLocaleDateString('fr-FR') : 'N/A' %></td>
                            <td style="padding: 8px;"><%= resv.endDate ? new Date(resv.endDate).toLocaleDateString('fr-FR') : 'N/A' %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="5" style="padding: 10px; text-align: center; color: #666;">Aucune réservation n'est enregistrée.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <div class="add-catway-section">
        <h2>Ajouter un nouveau Catway</h2>
        <form action="/dashboard/add" method="POST">
            <div>
                <label>Numéro :</label>
                <input type="number" name="catwayNumber" placeholder="Ex: 24" required>
            </div>
            <div>
                <label>Type :</label>
                <select name="catwayType" required>
                    <option value="long">Long</option>
                    <option value="short">Short</option>
                </select>
            </div>
            <div>
                <label>État :</label>
                <input type="text" name="catwayState" placeholder="Ex: parfait état" required>
            </div>
            <button type="submit" style="background-color: #28a745; margin-top: 10px;">Ajouter au port</button>
        </form>
    </div>
    
    <h2>Liste des Catways</h2>
    
    <% if (catways && catways.length > 0) { %>
        <ul style="padding-left: 0;">
            <% catways.forEach(function(catway) { %>
            <li>
                <span style="flex-grow: 1;">
                    <strong>Catway n°<%= catway.catwayNumber %></strong> - 
                    <span style="color: #666;"><%= catway.catwayType %></span> - 
                    <em><%= catway.catwayState %></em>
                </span>

                <a href="/dashboard/catways/<%= catway.catwayNumber %>/reservations" class="btn-reservations">Gérer Réservations</a>
                <a href="/dashboard/edit/<%= catway._id %>" class="btn-edit">Modifier</a>
                <button onclick="supprimerCatway('<%= catway._id %>')" class="btn-delete">Supprimer</button>
            </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>Aucun catway n'a été trouvé dans la base de données.</p>
    <% } %>

    <script>
        // 1. Script pour afficher la date du jour en français
        const optionsDate = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        // Met la première lettre en majuscule pour faire plus joli
        let dateString = new Date().toLocaleDateString('fr-FR', optionsDate);
        dateString = dateString.charAt(0).toUpperCase() + dateString.slice(1);
        document.getElementById('date-jour').textContent = "📅 " + dateString;

        // 2. Script pour la suppression des catways
        async function supprimerCatway(id) {
            if (confirm("Êtes-vous sûr de vouloir supprimer ce Catway ? Toutes ses données seront perdues.")) {
                try {
                    const response = await fetch('/dashboard/delete/' + id, {
                        method: 'DELETE'
                    });
                    
                    if (response.ok) {
                        window.location.reload(); 
                    } else {
                        alert("Erreur lors de la suppression.");
                    }
                } catch (err) {
                    console.error("Erreur:", err);
                    alert("Impossible de contacter le serveur.");
                }
            }
        }
    </script>

</body>
</html>